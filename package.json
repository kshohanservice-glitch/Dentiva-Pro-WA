{
  "name": "dentiva-pro",
  "productName": "Dentiva Pro",
  "version": "1.0.0",
  "description": "Premium offline dental practice management software for clinics in Bangladesh",
  "author": "Shohan Khan <helloiamshohan@gmail.com>",
  "license": "UNLICENSED",
  "private": true,
  "main": "dist-electron/electron/main.js",
  "homepage": "./",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "build:renderer": "vite build",
    "build:main": "tsc -p tsconfig.electron.json && node scripts/copy-assets.mjs",
    "build": "npm run build:main && npm run build:renderer",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.electron.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "dist:win": "electron-builder --win",
    "dist:dir": "electron-builder --dir",
    "scan": "node scripts/source-audit.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "5.2.5",
    "@fontsource/noto-sans-bengali": "5.2.5",
    "adm-zip": "0.5.16",
    "better-sqlite3": "11.10.0",
    "lucide-react": "0.469.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.28.1",
    "recharts": "2.15.0"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.0",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.1.0",
    "@types/adm-zip": "0.5.7",
    "@types/better-sqlite3": "7.6.11",
    "@types/node": "22.10.2",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "4.3.4",
    "concurrently": "9.1.2",
    "cross-env": "7.0.3",
    "electron": "33.3.1",
    "electron-builder": "25.1.8",
    "eslint": "9.17.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "jsdom": "25.0.1",
    "typescript": "5.7.2",
    "typescript-eslint": "8.18.2",
    "vite": "5.4.11",
    "vitest": "2.1.8",
    "wait-on": "8.0.1"
  }
}
